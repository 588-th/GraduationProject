<Page x:Class="Interface.Pages.Realtime"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:controls="clr-namespace:Interface.Controls" 
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="Model train">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="37*"/>
            <RowDefinition Height="83*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <!-- Control -->
        <Border  CornerRadius="5" Background="{DynamicResource BackgroundSecondary}" Margin="10,10,10,10" Grid.Column="1">
            <Grid>
                <TextBlock Text="Control" FontSize="22" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <controls:CustomButton x:Name="ButtonStartRecord" ControlBackground="{DynamicResource ButtonBackgroundFirstType}" ControlBorderBrush="{DynamicResource BorderPrimary}" ControlMouseOverBackground="{DynamicResource ButtonOverFirstType}" ControlMouseOverBorderBrush="{DynamicResource BorderSecondary}" ControlForeground="{DynamicResource TextPrimary}" ControlBorderThickness="1" ControlContent="Start" ControlFontSize="14" ControlMousePressedMargin="2" BorderThickness="1" Margin="10,0,10,50" VerticalAlignment="Bottom" Height="30" Grid.ColumnSpan="2"/>
                <controls:CustomButton x:Name="ButtonStopRecord" ControlBackground="{DynamicResource ButtonBackgroundFirstType}" ControlBorderBrush="{DynamicResource BorderPrimary}" ControlMouseOverBackground="{DynamicResource ButtonOverFirstType}" ControlMouseOverBorderBrush="{DynamicResource BorderSecondary}" ControlForeground="{DynamicResource TextPrimary}" ControlBorderThickness="1" ControlContent="Stop" ControlFontSize="14" ControlMousePressedMargin="2" BorderThickness="1" Margin="10,0,10,10" VerticalAlignment="Bottom" Height="30" Grid.ColumnSpan="2"/>
            </Grid>
        </Border>

        <!-- Recognized states -->
        <Border  CornerRadius="5" Background="{DynamicResource BackgroundSecondary}" Margin="10,10,10,10" Grid.RowSpan="2">
            <Grid>
                <TextBlock Text="Recognized states" FontSize="22" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <lvc:CartesianChart x:Name="ChartRecognizedStates" Margin="10,65,10,15" LegendPosition="Right" LegendTextPaint="{Binding LegendTextPaint}" YAxes="{Binding YAxes}"/>
            </Grid>
        </Border>

        <!-- Recognized word -->
        <Border Grid.Column="1" Grid.Row="1" CornerRadius="5" Background="{DynamicResource BackgroundSecondary}" Margin="10,10,10,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Words" FontSize="22" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="12,10,12,0" Grid.ColumnSpan="2"/>

                <ListView x:Name="ListViewRecognizedWord" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Hidden" Margin="5,44,10,45" Grid.ColumnSpan="2">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <controls:CustomButton x:Name="ButtonClearRecognizedWords" ControlBackground="{DynamicResource ButtonBackgroundFirstType}" ControlBorderBrush="{DynamicResource BorderPrimary}" ControlMouseOverBackground="{DynamicResource ButtonOverFirstType}" ControlMouseOverBorderBrush="{DynamicResource BorderSecondary}" ControlForeground="{DynamicResource TextPrimary}" ControlBorderThickness="1" ControlContent="Clear" ControlFontSize="14" ControlMousePressedMargin="2" BorderThickness="1" Margin="10,0,10,10" VerticalAlignment="Bottom" Height="30" Grid.ColumnSpan="2"/>

            </Grid>

        </Border>

    </Grid>

</Page>
