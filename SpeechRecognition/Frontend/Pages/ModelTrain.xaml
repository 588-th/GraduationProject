<Page x:Class="Interface.Pages.ModelTrain"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Interface.Pages"
      xmlns:controls="clr-namespace:Interface.Controls" 
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="Model train">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="304*"/>
            <RowDefinition Height="107*"/>
            <RowDefinition Height="189*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="46*"/>
            <ColumnDefinition Width="11*"/>
        </Grid.ColumnDefinitions>

        <!-- Recognized states -->
        <Border Grid.Column="1"  CornerRadius="5" Background="{DynamicResource BackgroundSecondary}" Margin="10" Grid.RowSpan="3">
            <Grid>
                <TextBlock Text="Recognized states" FontSize="22" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <controls:CustomButton x:Name="ButtonSetMinWeight" ControlBackground="{DynamicResource ButtonBackgroundFirstType}" ControlBorderBrush="{DynamicResource BorderPrimary}" ControlMouseOverBackground="{DynamicResource ButtonOverFirstType}" ControlMouseOverBorderBrush="{DynamicResource BorderSecondary}" ControlForeground="{DynamicResource TextPrimary}" ControlBorderThickness="1" ControlContent="min weight" ControlFontSize="14" ControlMousePressedMargin="2" HorizontalAlignment="Left" BorderThickness="1" Margin="10,35,0,0" VerticalAlignment="Top" Height="25" Width="85"/>
                <TextBox x:Name="TextBoxMinWeight" BorderThickness="0" Text="0" HorizontalContentAlignment="Center" Height="24" Margin="27,8,0,0" VerticalContentAlignment="Center" VerticalAlignment="Top" Background="{DynamicResource BackgroundTertiary}" FontSize="16" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Left" Width="51"/>
                <lvc:CartesianChart x:Name="ChartRecognizedStates" Margin="10,65,10,15" LegendPosition="Right" LegendTextPaint="{Binding LegendTextPaint}" YAxes="{Binding YAxes}"/>
            </Grid>
        </Border>

        <!-- Recognize -->
        <Border Grid.Column="0" Grid.Row="0" CornerRadius="5" Background="{DynamicResource BackgroundSecondary}" Margin="10" Grid.RowSpan="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="230*"/>
                    <RowDefinition Height="159*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <controls:CustomButton x:Name="ButtonRecognize" ControlBackground="{DynamicResource ButtonBackgroundFirstType}" ControlBorderBrush="{DynamicResource BorderPrimary}" ControlMouseOverBackground="{DynamicResource ButtonOverFirstType}" ControlMouseOverBorderBrush="{DynamicResource BorderSecondary}" ControlForeground="{DynamicResource TextPrimary}" ControlBorderThickness="1" ControlContent="Recognize" ControlFontSize="14" ControlMousePressedMargin="2" BorderThickness="1" Margin="15,15,15,0" VerticalAlignment="Top" Height="30"/>
                    <controls:FileExplorer x:Name="FileExplorerRecognize" ControlForeground="{DynamicResource TextPrimary}" ControlBorderThickness="1" BorderBrush="{DynamicResource BorderPrimary}" ControlBackground="{DynamicResource BackgroundSecondary}" ControlCornerRadius="10" ControlTag="Recognize" Margin="15,60,15,10"/>
                </Grid>

                <Border BorderThickness="1" BorderBrush="{DynamicResource BorderPrimary}" Background="{DynamicResource BackgroundSecondary}" CornerRadius="10" Margin="15,10,15,47" Grid.Row="1">
                    <Grid>
                        <TextBlock Text="Audio file information" FontSize="14" Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" VerticalAlignment="Top"/>
                        <TextBlock x:Name="TextBlockAudioFileInformation"  HorizontalAlignment="Left" Margin="10,35,0,0" Foreground="{DynamicResource TextPrimary}" Text="None" TextWrapping="Wrap" VerticalAlignment="Top"/>
                    </Grid>
                </Border>

                <controls:CustomButton x:Name="ButtonPlayStopAudio" ControlBackground="{DynamicResource ButtonBackgroundFirstType}" ControlBorderBrush="{DynamicResource BorderPrimary}" ControlMouseOverBackground="{DynamicResource ButtonOverFirstType}" ControlMouseOverBorderBrush="{DynamicResource BorderSecondary}" ControlForeground="{DynamicResource TextPrimary}" ControlBorderThickness="1" ControlContent="Play" ControlFontSize="14" ControlMousePressedMargin="2" BorderThickness="1" Margin="15,0,15,10" VerticalAlignment="Bottom" Height="30" Grid.Row="1"/>

            </Grid>
        </Border>

        <!-- Train -->
        <Border Grid.Column="0" Grid.Row="2" CornerRadius="5" Background="{DynamicResource BackgroundSecondary}" Margin="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <controls:CustomButton x:Name="ButtonTrain" ControlBackground="{DynamicResource ButtonBackgroundFirstType}" ControlBorderBrush="{DynamicResource BorderPrimary}" ControlMouseOverBackground="{DynamicResource ButtonOverFirstType}" ControlMouseOverBorderBrush="{DynamicResource BorderSecondary}" ControlForeground="{DynamicResource TextPrimary}" ControlBorderThickness="1" ControlContent="Train" ControlFontSize="14" ControlMousePressedMargin="2" BorderThickness="1" Margin="15,15,5,0" VerticalAlignment="Top" Height="30" Grid.Column="0"/>
                <controls:CustomButton x:Name="ButtonRetrain" ControlBackground="{DynamicResource ButtonBackgroundFirstType}" ControlBorderBrush="{DynamicResource BorderPrimary}" ControlMouseOverBackground="{DynamicResource ButtonOverFirstType}" ControlMouseOverBorderBrush="{DynamicResource BorderSecondary}" ControlForeground="{DynamicResource TextPrimary}" ControlBorderThickness="1" ControlContent="Retrain" ControlFontSize="14" ControlMousePressedMargin="2" BorderThickness="1" Margin="5,15,5,0" VerticalAlignment="Top" Height="30" Grid.Column="1"/>
                <controls:CustomButton x:Name="ButtonStopTrain" ControlBackground="{DynamicResource ButtonBackgroundFirstType}" ControlBorderBrush="{DynamicResource BorderPrimary}" ControlMouseOverBackground="{DynamicResource ButtonOverFirstType}" ControlMouseOverBorderBrush="{DynamicResource BorderSecondary}" ControlForeground="{DynamicResource TextPrimary}" ControlBorderThickness="1" ControlContent="Stop" ControlFontSize="14" ControlMousePressedMargin="2" BorderThickness="1" Margin="5,15,15,0" VerticalAlignment="Top" Height="30" Grid.Column="3"/>

                <Border BorderThickness="1" BorderBrush="{DynamicResource BorderPrimary}" Background="{DynamicResource BackgroundSecondary}" CornerRadius="10" Margin="15,55,15,0" VerticalAlignment="Top" Height="70" Grid.ColumnSpan="3">
                    <Grid>
                        <TextBlock x:Name="TextBlockTrainTime" Text="Train time: 00:00:00" Foreground="{DynamicResource TextPrimary}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0"/>
                        <TextBlock x:Name="TextBlockCycles" Text="Cycles: 0" Foreground="{DynamicResource TextPrimary}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,40,0,0"/>
                    </Grid>
                </Border>

                <controls:CustomButton x:Name="ButtonSaveModel" ControlBackground="{DynamicResource ButtonBackgroundFirstType}" ControlBorderBrush="{DynamicResource BorderPrimary}" ControlMouseOverBackground="{DynamicResource ButtonOverFirstType}" ControlMouseOverBorderBrush="{DynamicResource Blue}" ControlForeground="{DynamicResource TextPrimary}" ControlContent="Save trained model" ControlFontSize="14" ControlBorderThickness="1" ControlMousePressedMargin="2" ControlFontWeight="Bold" Height="25" VerticalAlignment="Bottom" Margin="15,0,15,10" Grid.ColumnSpan="3"/>

            </Grid>
        </Border>

        <!-- Recognition accuracy -->
        <Border Grid.Column="2" Grid.Row="0"  CornerRadius="5" Background="{DynamicResource BackgroundSecondary}" Margin="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Accuracy" FontSize="22" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="12,10,12,0" Grid.ColumnSpan="2"/>
                <ListView x:Name="ListViewAccuracy" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Hidden" Margin="5,80,5,50" Grid.Column="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <ListView x:Name="ListViewAccuracyWord" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Hidden" Margin="5,80,5,50" Grid.Column="1">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="HorizontalContentAlignment" Value="Right" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <controls:CustomButton x:Name="ButtonCalculateAccuracy" ControlBackground="{DynamicResource ButtonBackgroundFirstType}" ControlBorderBrush="{DynamicResource BorderPrimary}" ControlMouseOverBackground="{DynamicResource ButtonOverFirstType}" ControlMouseOverBorderBrush="{DynamicResource BorderSecondary}" ControlForeground="{DynamicResource TextPrimary}" ControlBorderThickness="1" ControlContent="Calculate" ControlFontSize="14" ControlMousePressedMargin="2" BorderThickness="1" Margin="10,45,10,0" VerticalAlignment="Top" Height="30" Grid.ColumnSpan="2"/>
                <controls:CustomButton x:Name="ButtonClearAccuracy" ControlBackground="{DynamicResource ButtonBackgroundFirstType}" ControlBorderBrush="{DynamicResource BorderPrimary}" ControlMouseOverBackground="{DynamicResource ButtonOverFirstType}" ControlMouseOverBorderBrush="{DynamicResource BorderSecondary}" ControlForeground="{DynamicResource TextPrimary}" ControlBorderThickness="1" ControlContent="Clear" ControlFontSize="14" ControlMousePressedMargin="2" BorderThickness="1" Margin="10,0,10,10" VerticalAlignment="Bottom" Height="30" Grid.ColumnSpan="2"/>

                <TextBlock x:Name="TextBlockCalculateAccuracyProcessing" HorizontalAlignment="Center" Margin="0,0,0,45" Text="Processing ..." Visibility="Hidden" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Bottom" Grid.ColumnSpan="2"/>

            </Grid>
        </Border>

        <!-- Recognized word -->
        <Border Grid.Column="2" Grid.Row="1" CornerRadius="5" Background="{DynamicResource BackgroundSecondary}" Margin="10" Grid.RowSpan="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Words" FontSize="22" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="12,10,12,0" Grid.ColumnSpan="2"/>

                <ListView x:Name="ListViewRecognizedWord" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Hidden" Margin="5,44,10,45" Grid.ColumnSpan="2">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <controls:CustomButton x:Name="ButtonClearRecognizedWords" ControlBackground="{DynamicResource ButtonBackgroundFirstType}" ControlBorderBrush="{DynamicResource BorderPrimary}" ControlMouseOverBackground="{DynamicResource ButtonOverFirstType}" ControlMouseOverBorderBrush="{DynamicResource BorderSecondary}" ControlForeground="{DynamicResource TextPrimary}" ControlBorderThickness="1" ControlContent="Clear" ControlFontSize="14" ControlMousePressedMargin="2" BorderThickness="1" Margin="10,0,10,10" VerticalAlignment="Bottom" Height="30" Grid.ColumnSpan="2"/>

            </Grid>

        </Border>

    </Grid>

</Page>