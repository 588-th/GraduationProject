<Page x:Class="Interface.Pages.AudioProcessing"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Interface.Pages"
      xmlns:controls="clr-namespace:Interface.Controls" 
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="Audio processing">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="304*"/>
            <RowDefinition Height="107*"/>
            <RowDefinition Height="189*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="151*"/>
        </Grid.ColumnDefinitions>

        <!-- Processing -->
        <Border Grid.Column="0" Grid.Row="0" CornerRadius="5" Background="{DynamicResource BackgroundSecondary}" Margin="10" Grid.RowSpan="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="230*"/>
                    <RowDefinition Height="159*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <controls:CustomButton x:Name="ButtonProcessing" ControlBackground="{DynamicResource ButtonBackgroundFirstType}" ControlBorderBrush="{DynamicResource BorderPrimary}" ControlMouseOverBackground="{DynamicResource ButtonOverFirstType}" ControlMouseOverBorderBrush="{DynamicResource BorderSecondary}" ControlForeground="{DynamicResource TextPrimary}" ControlBorderThickness="1" ControlContent="Processing" ControlFontSize="14" ControlMousePressedMargin="2" BorderThickness="1" Margin="15,15,15,0" VerticalAlignment="Top" Height="30"/>
                    <controls:FileExplorer x:Name="FileExplorerRecognize" ControlForeground="{DynamicResource TextPrimary}" ControlBorderThickness="1" BorderBrush="{DynamicResource BorderPrimary}" ControlBackground="{DynamicResource BackgroundSecondary}" ControlCornerRadius="10" Margin="15,60,15,10"/>
                </Grid>

                <Border BorderThickness="1" BorderBrush="{DynamicResource BorderPrimary}" Background="{DynamicResource BackgroundSecondary}" CornerRadius="10" Margin="15,10,15,47" Grid.Row="1">
                    <Grid>
                        <TextBlock Text="Audio file information" FontSize="14" Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" VerticalAlignment="Top"/>
                        <TextBlock x:Name="TextBlockAudioFileInformation"  HorizontalAlignment="Left" Margin="10,35,0,0" Foreground="{DynamicResource TextPrimary}" Text="None" TextWrapping="Wrap" VerticalAlignment="Top"/>
                    </Grid>
                </Border>

                <controls:CustomButton x:Name="ButtonPlayStopAudio" ControlBackground="{DynamicResource ButtonBackgroundFirstType}" ControlBorderBrush="{DynamicResource BorderPrimary}" ControlMouseOverBackground="{DynamicResource ButtonOverFirstType}" ControlMouseOverBorderBrush="{DynamicResource BorderSecondary}" ControlForeground="{DynamicResource TextPrimary}" ControlBorderThickness="1" ControlContent="Play" ControlFontSize="14" ControlMousePressedMargin="2" BorderThickness="1" Margin="15,0,15,10" VerticalAlignment="Bottom" Height="30" Grid.Row="1"/>
                
            </Grid>
        </Border>

        <!-- Audio Processing settings -->
        <Border Grid.Column="0" Grid.Row="2" CornerRadius="5" Background="{DynamicResource BackgroundSecondary}" Margin="10">
            <Grid>

                <TextBlock Text="Audio processing settings" FontSize="20" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock Text="Trim silents threshold DB" Foreground="{DynamicResource TextPrimary}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0"/>
                <TextBox x:Name="TextBoxTrimSilentsThreshold" BorderThickness="0" Height="25" Width="50" VerticalContentAlignment="Center"  VerticalAlignment="Top" HorizontalContentAlignment="Center" Background="{DynamicResource BackgroundTertiary}" FontSize="16" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,90,0,-30"/>

                <controls:CustomButton x:Name="ButtonApply" ControlBackground="{DynamicResource ButtonBackgroundFirstType}" ControlBorderBrush="{DynamicResource BorderPrimary}" ControlMouseOverBackground="{DynamicResource ButtonOverFirstType}" ControlMouseOverBorderBrush="{DynamicResource Blue}" ControlForeground="{DynamicResource TextPrimary}" ControlContent="Apply" ControlFontSize="14" ControlBorderThickness="1" ControlMousePressedMargin="2" ControlFontWeight="Bold" Height="25" VerticalAlignment="Bottom" Margin="15,0,15,10" Grid.ColumnSpan="2"/>

            </Grid>
        </Border>

        <!-- Sourse audio -->
        <Border Grid.Column="1" CornerRadius="5" Background="{DynamicResource BackgroundSecondary}" Margin="10">
            <Grid>
                <TextBlock Text="Sourse audio" FontSize="22" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <lvc:CartesianChart x:Name="ChartSourseAudio" Margin="10,65,10,15" LegendPosition="Right" LegendTextPaint="{Binding LegendTextPaint}"/>
            </Grid>
        </Border>

        <!-- Processing audio -->
        <Border Grid.Column="1" Grid.Row="1" CornerRadius="5" Background="{DynamicResource BackgroundSecondary}" Margin="10" Grid.RowSpan="2">
            <Grid>
                <TextBlock Text="Processing audio" FontSize="22" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <lvc:CartesianChart x:Name="ChartProcessingAudio" Margin="10,65,10,15" LegendPosition="Right" LegendTextPaint="{Binding LegendTextPaint}"/>
            </Grid>
        </Border>

    </Grid>

</Page>