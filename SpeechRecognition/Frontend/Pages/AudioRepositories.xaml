<Page x:Class="Interface.Pages.AudioRepositories" 
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Interface.Pages"
      xmlns:controls="clr-namespace:Interface.Controls"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="Audio Repositories">

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="270"/>
            <RowDefinition/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- Audio settings -->
        <Border Grid.Row="0" CornerRadius="15" Background="{DynamicResource BackgroundSecondary}" Margin="10,10,10,10" Grid.ColumnSpan="3">
            <Grid>
                <Grid x:Name="GridStatus" Height="4" VerticalAlignment="Top"/>

                <TextBlock Text="Audio repositories" FontSize="20" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock Text="Audio Training States Folder Path" Foreground="{DynamicResource TextPrimary}" FontSize="14" HorizontalAlignment="Left" Margin="21,70,0,0" VerticalAlignment="Top"/>
                <TextBlock Text="Audio Training Words Folder Path" Foreground="{DynamicResource TextPrimary}" FontSize="14" HorizontalAlignment="Left" Margin="21,120,0,0" VerticalAlignment="Top"/>
                <TextBlock Text="Audio Recognize Folder Path" Foreground="{DynamicResource TextPrimary}" FontSize="14" HorizontalAlignment="Left" Margin="21,170,0,0" VerticalAlignment="Top"/>
                <TextBox x:Name="TextBoxAudioTrainingStatesFolderPath" BorderThickness="0" Height="25" Margin="255,70,85,0" VerticalContentAlignment="Center" VerticalAlignment="Top" Background="{DynamicResource BackgroundTertiary}" FontSize="16" Foreground="{DynamicResource TextSecondary}"/>
                <TextBox x:Name="TextBoxAudioTrainingWordsFolderPath" BorderThickness="0" Height="25" Margin="255,120,85,0" VerticalContentAlignment="Center" VerticalAlignment="Top" Background="{DynamicResource BackgroundTertiary}" FontSize="16" Foreground="{DynamicResource TextSecondary}"/>
                <TextBox x:Name="TextBoxAudioRecognizeFolderPath" BorderThickness="0" Height="25" Margin="255,170,85,0" VerticalContentAlignment="Center" VerticalAlignment="Top" Background="{DynamicResource BackgroundTertiary}" FontSize="16" Foreground="{DynamicResource TextSecondary}"/>

                <controls:CustomButton x:Name="ButtonStatesFolderPath" ControlBackground="{DynamicResource ButtonBackgroundSecondType}" ControlMouseOverBackground="{DynamicResource ButtonOverSecondType}" ControlForeground="{DynamicResource TextPrimary}" ControlContent="..." ControlFontSize="14" ControlMousePressedMargin="2" ControlFontWeight="Bold" Margin="0,70,30,0" VerticalAlignment="Top" Height="25" HorizontalAlignment="Right" Width="50"/>
                <controls:CustomButton x:Name="ButtonWordsFolderPath" ControlBackground="{DynamicResource ButtonBackgroundSecondType}" ControlMouseOverBackground="{DynamicResource ButtonOverSecondType}" ControlForeground="{DynamicResource TextPrimary}" ControlContent="..." ControlFontSize="14" ControlMousePressedMargin="2" ControlFontWeight="Bold" Margin="0,120,30,0" VerticalAlignment="Top" Height="25" HorizontalAlignment="Right" Width="50"/>
                <controls:CustomButton x:Name="ButtonRecognizeFolderPath" ControlBackground="{DynamicResource ButtonBackgroundSecondType}" ControlMouseOverBackground="{DynamicResource ButtonOverSecondType}" ControlForeground="{DynamicResource TextPrimary}" ControlContent="..." ControlFontSize="14" ControlMousePressedMargin="2" ControlFontWeight="Bold" Margin="0,170,30,0" VerticalAlignment="Top" Height="25" HorizontalAlignment="Right" Width="50"/>

                <controls:CustomButton x:Name="ButtonApply" ControlContent="Apply" ControlFontSize="14" ControlBorderThickness="1" ControlMouseOverBorderBrush="{DynamicResource Blue}" ControlBorderBrush="{DynamicResource BackgroundTertiary}" ControlMouseOverBackground="{DynamicResource ButtonOverSecondary}" ControlBackground="{DynamicResource BackgroundSecondary}" ControlMousePressedMargin="2" ControlForeground="{DynamicResource TextPrimary}" ControlFontWeight="Bold" Height="30" Width="80" VerticalAlignment="Bottom" Margin="0,0,0,10" Grid.ColumnSpan="2"/>

            </Grid>
        </Border>

        <!-- File Explorer States -->
        <Border Grid.Row="1" CornerRadius="15" Background="{DynamicResource BackgroundSecondary}" Margin="10,10,10,10" Grid.Column="0">
            <Grid>
                <controls:FileExplorer x:Name="FileExplorerStates" ControlForeground="{DynamicResource TextPrimary}" ControlBorderThickness="1" BorderBrush="{DynamicResource BorderPrimary}" ControlBackground="{DynamicResource BackgroundSecondary}" ControlCornerRadius="10" Margin="20,70,20,20" ControlTag="States"/>
                <TextBlock VerticalAlignment="Top" Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Text="States Train Folder"/>
            </Grid>
        </Border>

        <!-- File Explorer Words -->
        <Border Grid.Row="1" CornerRadius="15" Background="{DynamicResource BackgroundSecondary}" Margin="10,10,10,10" Grid.Column="1">
            <Grid>
                <controls:FileExplorer x:Name="FileExplorerWords" ControlForeground="{DynamicResource TextPrimary}" ControlBorderThickness="1" BorderBrush="{DynamicResource BorderPrimary}" ControlBackground="{DynamicResource BackgroundSecondary}" ControlCornerRadius="10" Margin="20,70,20,20" ControlTag="Words"/>
                <TextBlock VerticalAlignment="Top" Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Text="Words Train Folder"/>
            </Grid>
        </Border>

        <!-- File Explorer Recognize -->
        <Border Grid.Row="1" CornerRadius="15" Background="{DynamicResource BackgroundSecondary}" Margin="10,10,10,10" Grid.Column="2">
            <Grid>
                <controls:FileExplorer x:Name="FileExplorerRecognize" ControlForeground="{DynamicResource TextPrimary}" ControlBorderThickness="1" BorderBrush="{DynamicResource BorderPrimary}" ControlBackground="{DynamicResource BackgroundSecondary}" ControlCornerRadius="10" Margin="20,70,20,20" ControlTag="Recognize"/>
                <TextBlock VerticalAlignment="Top" Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Text="Recognize Folder"/>
            </Grid>
        </Border>

        <Border CornerRadius="10" Background="{DynamicResource BackgroundSecondary}" Margin="10,10,10,10" Grid.ColumnSpan="3" Grid.Row="2">
        </Border>
        <controls:CustomButton x:Name="ButtonInitRepositores" ControlBackground="{DynamicResource ButtonBackgroundFirstType}" ControlBorderBrush="{DynamicResource BorderPrimary}" ControlMouseOverBackground="{DynamicResource ButtonOverFirstType}" ControlMouseOverBorderBrush="{DynamicResource BorderSecondary}" ControlForeground="{DynamicResource TextPrimary}" ControlBorderThickness="1" ControlContent="Init Repositories" ControlFontSize="14" ControlMousePressedMargin="2" BorderThickness="1" Margin="107,0,107,0" VerticalAlignment="Center" Height="30" Grid.Column="1" Grid.Row="2" />

    </Grid>

</Page>