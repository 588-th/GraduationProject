<UserControl x:Class="Interface.Controls.FileExplorer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Interface.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="250">

    <Border BorderThickness="{Binding ControlBorderThickness}" BorderBrush="{Binding ControlBorderBrush}" Background="{Binding ControlBackground}" CornerRadius="{Binding ControlCornerRadius}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5"/>

            <TreeView x:Name="FileTreeView" Grid.Row="1" Background="Transparent" BorderThickness="0" Tag="{Binding ControlTag}">
                <TreeView.Resources>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="Foreground" Value="{Binding ControlForeground}" />
                        <Setter Property="Tag" Value="{Binding ControlTag}" />
                    </Style>
                </TreeView.Resources>
            </TreeView>
            
        </Grid>
    </Border>
    
</UserControl>