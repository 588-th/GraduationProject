<UserControl x:Class="Interface.Controls.CustomButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Interface.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="80">

    <UserControl.Resources>
        <Style x:Key="CustomButtonStyle" TargetType="Button">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Border" BorderBrush="{Binding ControlBorderBrush}" BorderThickness="{Binding ControlBorderThickness}" Background="{Binding ControlBackground}" CornerRadius="{Binding ControlCornerRadius}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0,5,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{Binding ControlMouseOverBackground}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{Binding ControlMouseOverBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Margin" Value="{Binding ControlMousePressedMargin}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Button x:Name="CButton" Content="{Binding ControlContent}" 
                Foreground="{Binding ControlForeground}" 
                FontSize="{Binding ControlFontSize}" 
                FontWeight="{Binding ControlFontWeight}" 
                BorderThickness="0"
                Style="{DynamicResource CustomButtonStyle}"/>
    </Grid>

</UserControl>
