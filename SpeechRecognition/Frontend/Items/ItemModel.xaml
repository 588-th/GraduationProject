<UserControl x:Class="Interface.Items.ItemModel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:Interface.Controls"
             xmlns:local="clr-namespace:Interface.Items"
             mc:Ignorable="d"
             Height="170" d:Width="300">

    <Grid Background="{DynamicResource BackgroundTertiary}" Margin="5">
        <TextBlock Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="10,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Text="Name:" />
        <TextBlock Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="10,40,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Text="Create date:" />
        <TextBlock Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="10,70,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Text="States num:" />
        <TextBlock Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="10,100,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Text="Words num:" />
        <TextBlock Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="10,130,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Text="Training time:" />

        <TextBlock Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="61,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" x:Name="TextBlockName" />
        <TextBlock Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="93,40,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" x:Name="TextBlockCreateDate" />
        <TextBlock Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="92,70,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" x:Name="TextBlockNumStates" />
        <TextBlock Foreground="{DynamicResource TextPrimary}"  FontSize="14" Margin="90,100,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" x:Name="TextBlockNumWords" />
        <TextBlock Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="103,130,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" x:Name="TextBlockTrainingTime" />

        <controls:CustomButton x:Name="ButtonModelDelete" ControlContent="X" ControlFontSize="6" ControlMouseOverBackground="{DynamicResource RedPrimary}" ControlMousePressedMargin="2" ControlForeground="{DynamicResource TextPrimary}" ControlFontWeight="Bold" ControlBackground="{DynamicResource RedSecondary}" Margin="0,4,4,0" VerticalAlignment="Top" Height="15" HorizontalAlignment="Right" Width="15"/>
    </Grid>

</UserControl>
