<Window x:Class="Interface.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Interface"
        xmlns:controls="clr-namespace:Interface.Controls" 
        mc:Ignorable="d"
        Name="Home"
        Title="SpeechRecognition - 1.2.7"
        MinHeight="740"
        MinWidth="1100"
        Height="740"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        FontFamily="Poppins">

    <Grid Background="{DynamicResource BackgroundPrimary}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Icon -->
        <Grid Grid.Column="0" Grid.Row="0" Background="{DynamicResource BackgroundSecondary}">
            <controls:CustomButton x:Name="ButtonLogo" Tag="Guide" Background="Transparent" ControlBackground="Transparent" ControlMouseOverBackground="Transparent" ControlMousePressedMargin="0" BorderThickness="0">
                <Image Source="/Images/Logo.png" Margin="10"/>
            </controls:CustomButton>
        </Grid>

        <!-- Menu -->
        <Grid Grid.Column="1" Grid.Row="0" Background="{DynamicResource BackgroundSecondary}">
            <StackPanel Orientation="Horizontal">

                <controls:CustomButton Width="125" ControlFontSize="14" ControlMouseOverBackground="{DynamicResource BackgroundTertiary}" ControlMousePressedMargin="2" ControlForeground="{DynamicResource TextPrimary}" ControlFontWeight="Bold" ControlBackground="{DynamicResource BackgroundSecondary}" HorizontalAlignment="Left" x:Name="ButtonModelList" Tag="ModelList" ControlContent="Models"/>
                <controls:CustomButton IsEnabled="False" Width="125" ControlFontSize="14" ControlMouseOverBackground="{DynamicResource BackgroundTertiary}" ControlMousePressedMargin="2" ControlForeground="{DynamicResource TextPrimary}" ControlFontWeight="Bold" ControlBackground="{DynamicResource BackgroundSecondary}" HorizontalAlignment="Left" x:Name="ButtonModelSettings" Tag="ModelSettings" ControlContent="Settings"/>
                <controls:CustomButton IsEnabled="False" Width="125" ControlFontSize="14" ControlMouseOverBackground="{DynamicResource BackgroundTertiary}" ControlMousePressedMargin="2" ControlForeground="{DynamicResource TextPrimary}" ControlFontWeight="Bold" ControlBackground="{DynamicResource BackgroundSecondary}" HorizontalAlignment="Left" x:Name="ButtonModelDictionaries" Tag="ModelDictionaries" ControlContent="Dictionaries"/>

                <Border BorderBrush="{DynamicResource BackgroundTertiary}" BorderThickness="1" Width="1" Height="40"/>

                <controls:CustomButton Width="125" ControlFontSize="14" ControlMouseOverBackground="{DynamicResource BackgroundTertiary}" ControlMousePressedMargin="2" ControlForeground="{DynamicResource TextPrimary}" ControlFontWeight="Bold" ControlBackground="{DynamicResource BackgroundSecondary}" HorizontalAlignment="Left" x:Name="ButtonModelAudioRepositories" Tag="AudioRepositories" ControlContent="Repository"/>

                <Border BorderBrush="{DynamicResource BackgroundTertiary}" BorderThickness="1" Width="1" Height="40"/>

                <controls:CustomButton IsEnabled="False" Width="125" ControlFontSize="14" ControlMouseOverBackground="{DynamicResource BackgroundTertiary}" ControlMousePressedMargin="2" ControlForeground="{DynamicResource TextPrimary}" ControlFontWeight="Bold" ControlBackground="{DynamicResource BackgroundSecondary}" HorizontalAlignment="Left" x:Name="ButtonTrainModel" Tag="ModelTrain" ControlContent="Train"/>
                <controls:CustomButton Visibility="Collapsed" IsEnabled="False" Width="125" ControlFontSize="14" ControlMouseOverBackground="{DynamicResource BackgroundTertiary}" ControlMousePressedMargin="2" ControlForeground="{DynamicResource TextPrimary}" ControlFontWeight="Bold" ControlBackground="{DynamicResource BackgroundSecondary}" HorizontalAlignment="Left" x:Name="ButtonRealtime" Tag="Realtime" ControlContent="Realtime"/>
                <controls:CustomButton IsEnabled="False" Width="125" ControlFontSize="14" ControlMouseOverBackground="{DynamicResource BackgroundTertiary}" ControlMousePressedMargin="2" ControlForeground="{DynamicResource TextPrimary}" ControlFontWeight="Bold" ControlBackground="{DynamicResource BackgroundSecondary}" HorizontalAlignment="Left" x:Name="ButtonTranscription" Tag="Transcription" ControlContent="Transcription"/>
                <controls:CustomButton Visibility="Collapsed" IsEnabled="False" Width="125" ControlFontSize="14" ControlMouseOverBackground="{DynamicResource BackgroundTertiary}" ControlMousePressedMargin="2" ControlForeground="{DynamicResource TextPrimary}" ControlFontWeight="Bold" ControlBackground="{DynamicResource BackgroundSecondary}" HorizontalAlignment="Left" x:Name="ButtonAudioProcessing" Tag="AudioProcessing" ControlContent="Audio"/>

            </StackPanel>
        </Grid>

        <!-- Container -->
        <Frame Grid.Row="1" Name="FrameContainer" Margin="10" NavigationUIVisibility="Hidden" Grid.ColumnSpan="2"/>

        <!-- Status Bar -->
        <Grid Grid.Row="2" Background="{DynamicResource BackgroundSecondary}" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Width="490" Margin="20,0,0,0">

                <TextBlock Text="Model: " Foreground="{DynamicResource TextPrimary}" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center" Height="16"/>
                <TextBlock x:Name="TextBlockModel" Text="None" Foreground="{DynamicResource TextPrimary}" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center" Height="16" Margin="10,0,0,0"/>

                <Border BorderBrush="{DynamicResource BackgroundTertiary}" BorderThickness="1" Width="1" Height="20" Margin="10,0,0,0"/>

                <TextBlock Text="Trained: " Foreground="{DynamicResource TextPrimary}" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center" Height="16" Margin="10,0,0,0"/>
                <TextBlock x:Name="TextBlockTrained" Text="No" Foreground="{DynamicResource TextPrimary}" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center" Height="16" Margin="10,0,0,0"/>

            </StackPanel>

            <ProgressBar x:Name="ProgressBar" Visibility="Collapsed" Grid.Column="1" Foreground="{DynamicResource Blue}" Background="{DynamicResource BackgroundTertiary}" BorderThickness="0" Height="10" Width="150" Margin="1030,0,20,10" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
            <TextBlock x:Name="TextBlockProgressBar" Visibility="Collapsed" Text="" Foreground="{DynamicResource TextPrimary}" FontSize="14" VerticalAlignment="Bottom" Height="16" Margin="0,0,175,7" HorizontalAlignment="Right"/>

        </Grid>

        <Button x:Name="ButtonSwitchTheme" Background="Transparent" BorderThickness="0" Grid.Column="1" Margin="0,0,20,20" HorizontalAlignment="Right" Width="26" Height="26" VerticalAlignment="Bottom">
            <Image Source="{DynamicResource Theme}" IsHitTestVisible="False"/>
        </Button>

    </Grid>

</Window>