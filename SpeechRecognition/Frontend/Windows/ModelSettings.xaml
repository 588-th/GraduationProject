<Window x:Class="Interface.Windows.ModelSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Interface.Windows"
        xmlns:controls="clr-namespace:Interface.Controls"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Model settings"
        Width="400" Height="620"
        MinWidth="400" MinHeight="300">

    <Grid Background="{DynamicResource BackgroundSecondary}">
        <Grid x:Name="GridStatus" Height="4" VerticalAlignment="Top"/>

        <StackPanel Margin="0,0,0,50">

            <!-- Model settings -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Model" FontSize="20" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0" Grid.ColumnSpan="2"/>
                <TextBlock Text="Model name" Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="30,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.ColumnSpan="2" Grid.Row="1"/>
                <TextBox x:Name="TextBoxModelName" BorderThickness="0" Height="25" Width="150" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="{DynamicResource BackgroundTertiary}" FontSize="16" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Grid.Row="1" Grid.Column="1" Margin="0,8,0,8"/>

            </Grid>

            <Border BorderBrush="{DynamicResource BackgroundTertiary}" BorderThickness="1" Margin="15,0,15,0"/>

            <!-- MFCC settings -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>

                <TextBlock Text="MFCC settings" FontSize="20" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0" Grid.ColumnSpan="2"/>

                <TextBlock Text="i" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="12,3,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.ColumnSpan="2" Grid.Row="1" FontFamily="Consolas">
                    <TextBlock.ToolTip>
                        <ToolTip>
                            <StackPanel>
                                <TextBlock Text="Number of filters used in the Mel-filterbank for MFCC extraction." />
                                <TextBlock Text="Default value: 26" />
                            </StackPanel>
                        </ToolTip>
                    </TextBlock.ToolTip>
                </TextBlock>

                <TextBlock Text="Num Filters" Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="30,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.ColumnSpan="2" Grid.Row="1"/>
                <TextBox x:Name="TextBoxNumFilters" BorderThickness="0" Height="25" Width="50" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="{DynamicResource BackgroundTertiary}" FontSize="16" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Grid.Row="1" Grid.Column="1"/>

                <TextBlock Text="i" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="12,3,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.ColumnSpan="2" Grid.Row="2" FontFamily="Consolas">
                    <TextBlock.ToolTip>
                        <ToolTip>
                            <StackPanel>
                                <TextBlock Text="Number of cepstral coefficients to be retained in the MFCC computation." />
                                <TextBlock Text="Default value: 13" />
                            </StackPanel>
                        </ToolTip>
                    </TextBlock.ToolTip>
                </TextBlock>
                <TextBlock Text="Num Cepstral Coefficients" Foreground="{DynamicResource TextPrimary}" Margin="30,0,0,0" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.ColumnSpan="2" Grid.Row="2"/>
                <TextBox x:Name="TextBoxNumCepstralCoefficients" BorderThickness="0" Height="25" Width="50" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="{DynamicResource BackgroundTertiary}" FontSize="16" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Grid.Row="2" Grid.Column="1"/>

                <TextBlock Text="i" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="12,3,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.ColumnSpan="2" Grid.Row="3" FontFamily="Consolas">
                    <TextBlock.ToolTip>
                        <ToolTip>
                            <StackPanel>
                                <TextBlock Text="Duration of each frame in milliseconds used in the MFCC extraction." />
                                <TextBlock Text="Default value: 20" />
                            </StackPanel>
                        </ToolTip>
                    </TextBlock.ToolTip>
                </TextBlock>
                <TextBlock Text="Frame Duration Ms" Foreground="{DynamicResource TextPrimary}" Margin="30,0,0,0" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.ColumnSpan="2" Grid.Row="3"/>
                <TextBox x:Name="TextBoxFrameDurationMs" BorderThickness="0" Height="25" Width="50" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="{DynamicResource BackgroundTertiary}" FontSize="16" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Grid.Row="3" Grid.Column="1"/>

                <TextBlock Text="i" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="12,3,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.ColumnSpan="2" Grid.Row="4" FontFamily="Consolas">
                    <TextBlock.ToolTip>
                        <ToolTip>
                            <StackPanel>
                                <TextBlock Text="Duration of overlap between consecutive frames in milliseconds." />
                                <TextBlock Text="Default value: 10" />
                            </StackPanel>
                        </ToolTip>
                    </TextBlock.ToolTip>
                </TextBlock>
                <TextBlock Text="Frame Overlap Duration Ms" Foreground="{DynamicResource TextPrimary}" Margin="30,0,0,0" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.ColumnSpan="2" Grid.Row="4"/>
                <TextBox x:Name="TextBoxFrameOverlapDurationMs" BorderThickness="0" Height="25" Width="50" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="{DynamicResource BackgroundTertiary}" FontSize="16" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Grid.Row="4" Grid.Column="1"/>

            </Grid>

            <Border BorderBrush="{DynamicResource BackgroundTertiary}" BorderThickness="1" Margin="15,0,15,0"/>

            <!-- DNN settings -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>

                <TextBlock Text="DNN settings" FontSize="20" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0" Grid.ColumnSpan="2"/>

                <TextBlock Text="i" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="12,3,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.ColumnSpan="2" Grid.Row="1" FontFamily="Consolas">
                    <TextBlock.ToolTip>
                        <ToolTip Content="Number of times the model is trained per cicle using phoneme transcriptions"/>
                    </TextBlock.ToolTip>
                </TextBlock>
                <TextBlock Text="State training epoch" Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="30,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.ColumnSpan="2" Grid.Row="1"/>
                <TextBox x:Name="TextBoxNumStatesTrainingEpoch" BorderThickness="0" Height="25" Width="50" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="{DynamicResource BackgroundTertiary}" FontSize="16" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Grid.Row="1" Grid.Column="1"/>

                <TextBlock Text="i" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="12,3,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.ColumnSpan="2" Grid.Row="2" FontFamily="Consolas">
                    <TextBlock.ToolTip>
                        <ToolTip Content="Number of times the model is trained per cicle using word transcriptions"/>
                    </TextBlock.ToolTip>
                </TextBlock>
                <TextBlock Text="Word training epoch" Foreground="{DynamicResource TextPrimary}" Margin="30,0,0,0" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.ColumnSpan="2" Grid.Row="2"/>
                <TextBox x:Name="TextBoxNumWordsTrainingEpoch" BorderThickness="0" Height="25" Width="50" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="{DynamicResource BackgroundTertiary}" FontSize="16" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Grid.Row="2" Grid.Column="1"/>

                <TextBlock Text="i" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="12,3,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.ColumnSpan="2" Grid.Row="3" FontFamily="Consolas">
                    <TextBlock.ToolTip>
                        <ToolTip Content="The number of cycles in which one audio read and the specified number of epochs are performed"/>
                    </TextBlock.ToolTip>
                </TextBlock>
                <TextBlock Text="Num of cicles" Foreground="{DynamicResource TextPrimary}" Margin="30,0,0,0" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.ColumnSpan="2" Grid.Row="3"/>
                <TextBox x:Name="TextBoxNumCicles" BorderThickness="0" Height="25" Width="50" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="{DynamicResource BackgroundTertiary}" FontSize="16" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Grid.Row="3" Grid.Column="1"/>

            </Grid>

        </StackPanel>

        <controls:CustomButton x:Name="ButtonApply" ControlBackground="{DynamicResource ButtonBackgroundFirstType}" ControlBorderBrush="{DynamicResource BorderPrimary}" ControlMouseOverBackground="{DynamicResource ButtonOverFirstType}" ControlMouseOverBorderBrush="{DynamicResource Blue}" ControlForeground="{DynamicResource TextPrimary}" ControlContent="Apply" ControlFontSize="14" ControlBorderThickness="1" ControlMousePressedMargin="2" ControlFontWeight="Bold" Height="35" VerticalAlignment="Bottom" Margin="10,0,10,10"/>

    </Grid>

</Window>
