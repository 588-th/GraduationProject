<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:Interface.Windows"
    xmlns:controls="clr-namespace:Interface.Controls" x:Class="Interface.Windows.Message"
    mc:Ignorable="d"
    WindowStartupLocation="CenterScreen"
    Title="Message" Height="175" Width="350">

    <Grid Background="{DynamicResource BackgroundSecondary}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <controls:CustomButton x:Name="ButtonYes" ControlBackground="{DynamicResource ButtonBackgroundFirstType}" ControlBorderBrush="{DynamicResource BorderPrimary}" ControlMouseOverBackground="{DynamicResource ButtonOverFirstType}" ControlMouseOverBorderBrush="{DynamicResource BorderSecondary}" ControlForeground="{DynamicResource TextPrimary}" ControlContent="Yes" ControlFontSize="14" ControlBorderThickness="1" ControlMousePressedMargin="2" Height="30" VerticalAlignment="Bottom" Margin="30,0,30,10"/>
        <controls:CustomButton x:Name="ButtonNo" ControlBackground="{DynamicResource ButtonBackgroundFirstType}" ControlBorderBrush="{DynamicResource BorderPrimary}" ControlMouseOverBackground="{DynamicResource ButtonOverFirstType}" ControlMouseOverBorderBrush="{DynamicResource BorderSecondary}" ControlForeground="{DynamicResource TextPrimary}" ControlContent="No" ControlFontSize="14" ControlBorderThickness="1" ControlMousePressedMargin="2" Height="30" VerticalAlignment="Bottom" Margin="30,0,30,10" Grid.Column="1"/>
        <TextBlock x:Name="TextBlockMessage" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}" FontSize="16" Margin="0,15,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Width="300" Grid.ColumnSpan="2"/>

    </Grid>
</Window>
