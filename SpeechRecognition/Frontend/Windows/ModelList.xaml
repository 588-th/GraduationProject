<Window x:Class="Interface.Windows.ModelList"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Interface.Windows"
        xmlns:controls="clr-namespace:Interface.Controls"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Height="600" Width="400"
        MinHeight="300" MinWidth="400"
        Title="Model list">

    <Grid Background="{DynamicResource BackgroundSecondary}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid x:Name="GridStatus" Height="4" VerticalAlignment="Top"/>

        <TextBlock Text="Models folder" Foreground="{DynamicResource TextPrimary}" FontSize="14" HorizontalAlignment="Center" Margin="0,25,0,0" VerticalAlignment="Top"/>

        <controls:CustomButton x:Name="ButtonSaveModelsFolderPath" ControlBackground="{DynamicResource ButtonBackgroundFirstType}" ControlBorderBrush="{DynamicResource BorderPrimary}" ControlMouseOverBackground="{DynamicResource ButtonOverFirstType}" ControlMouseOverBorderBrush="{DynamicResource Blue}" ControlForeground="{DynamicResource TextPrimary}" ControlBorderThickness="1" ControlContent="s" ControlFontSize="14" ControlMousePressedMargin="2" HorizontalAlignment="Left" BorderThickness="1" Margin="15,60,0,0" VerticalAlignment="Top" Height="25" Width="25"/>
        <TextBox x:Name="TextBoxModelsFolderPath" Background="{DynamicResource BackgroundTertiary}" Foreground="{DynamicResource TextSecondary}" BorderThickness="0" Height="25" Margin="45,60,70,0" VerticalContentAlignment="Center" VerticalAlignment="Top" FontSize="16"/>
        <controls:CustomButton x:Name="ButtonModelsFolderPath" ControlBackground="{DynamicResource ButtonBackgroundSecondType}" ControlMouseOverBackground="{DynamicResource ButtonOverSecondType}" ControlForeground="{DynamicResource TextPrimary}" ControlContent="..." ControlFontSize="14" ControlMousePressedMargin="2" ControlFontWeight="Bold" Margin="0,60,15,0" VerticalAlignment="Top" Height="25" HorizontalAlignment="Right" Width="50"/>

        <controls:CustomButton x:Name="ButtonUpdateList" ControlBackground="{DynamicResource ButtonBackgroundFirstType}" ControlBorderBrush="{DynamicResource BorderPrimary}" ControlMouseOverBackground="{DynamicResource ButtonOverFirstType}" ControlMouseOverBorderBrush="{DynamicResource BorderSecondary}" ControlForeground="{DynamicResource TextPrimary}" ControlBorderThickness="1" ControlContent="Update" ControlFontSize="14" ControlMousePressedMargin="2" BorderThickness="1" Margin="14,101,14,0" VerticalAlignment="Top" Height="30"/>

        <Border BorderBrush="{DynamicResource BorderPrimary}" Margin="15,130,15,50" BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
                <StackPanel x:Name="StackPanelModels" Orientation="Vertical" />
            </ScrollViewer>
        </Border>

        <controls:CustomButton x:Name="ButtonCreateModel" ControlBackground="{DynamicResource ButtonBackgroundSecondType}" ControlMouseOverBackground="{DynamicResource ButtonOverSecondType}" ControlForeground="{DynamicResource TextPrimary}" ControlContent="Create new model" ControlFontSize="14" ControlMousePressedMargin="2" ControlFontWeight="Bold" Height="37" VerticalAlignment="Bottom"/>

    </Grid>

</Window>