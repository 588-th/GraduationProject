<Window x:Class="Interface.Windows.Transcription"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Interface.Controls"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Height="300" Width="350"
        MinHeight="300" MinWidth="350"
        Title="Transcription">

    <Grid Background="{DynamicResource BackgroundSecondary}">

        <Grid x:Name="GridStatus" Height="4" VerticalAlignment="Top" Grid.ColumnSpan="2"/>



        <TextBlock Text="Transcription" FontSize="20" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0"/>
        <TextBox x:Name="TextBoxTranscription" BorderBrush="{DynamicResource BackgroundTertiary}" BorderThickness="1" Margin="10,124,10,50" TextWrapping="Wrap" AcceptsReturn="True" Background="{DynamicResource BackgroundSecondary}" FontSize="16" Foreground="{DynamicResource TextSecondary}"/>
        <controls:CustomButton x:Name="ButtonTranscribe" ControlBackground="{DynamicResource ButtonBackgroundFirstType}" ControlBorderBrush="{DynamicResource BorderPrimary}" ControlMouseOverBackground="{DynamicResource ButtonOverFirstType}" ControlMouseOverBorderBrush="{DynamicResource Blue}" ControlForeground="{DynamicResource TextPrimary}" ControlContent="Transcribe" ControlFontSize="14" ControlBorderThickness="1" ControlMousePressedMargin="2" ControlFontWeight="Bold" Margin="10,84,10,0" Height="35" VerticalAlignment="Top"/>
        <controls:CustomButton x:Name="ButtonSave" ControlBackground="{DynamicResource ButtonBackgroundFirstType}" ControlBorderBrush="{DynamicResource BorderPrimary}" ControlMouseOverBackground="{DynamicResource ButtonOverFirstType}" ControlMouseOverBorderBrush="{DynamicResource Blue}" ControlForeground="{DynamicResource TextPrimary}" ControlContent="Save" ControlFontSize="14" ControlBorderThickness="1" ControlMousePressedMargin="2" ControlFontWeight="Bold" Margin="10,0,10,10" Height="35" VerticalAlignment="Bottom"/>

    </Grid>
</Window>
