<Window x:Class="Interface.Windows.ModelDictionaries"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Interface.Windows"
        xmlns:controls="clr-namespace:Interface.Controls"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Height="600" Width="500"
        MinHeight="300" MinWidth="500"
        Title="Dictionaries">

    <Grid Background="{DynamicResource BackgroundSecondary}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="43*"/>
            <ColumnDefinition Width="57*"/>
        </Grid.ColumnDefinitions>

        <Grid x:Name="GridStatus" Height="4" VerticalAlignment="Top" Grid.ColumnSpan="2"/>

        <!-- State Dictionary -->
        <Border Margin="0,0,0,42">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="State dictionary" FontSize="20" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="28,10,0,0" Grid.ColumnSpan="3"/>
                <TextBox x:Name="TextBoxStateDictionary" BorderBrush="{DynamicResource BackgroundTertiary}" BorderThickness="1" Margin="10,90,10,10" TextWrapping="Wrap" AcceptsReturn="True" Background="{DynamicResource BackgroundSecondary}" FontSize="16" Foreground="{DynamicResource TextSecondary}" Grid.ColumnSpan="3"/>
                <controls:CustomButton x:Name="ButtonImportStates" ControlBackground="{DynamicResource ButtonBackgroundFirstType}" ControlBorderBrush="{DynamicResource BorderPrimary}" ControlMouseOverBackground="{DynamicResource ButtonOverFirstType}" ControlMouseOverBorderBrush="{DynamicResource BorderSecondary}" ControlForeground="{DynamicResource TextPrimary}" ControlBorderThickness="1" ControlContent="Import" ControlFontSize="14" ControlMousePressedMargin="2" BorderThickness="1" Margin="9,61,0,0" VerticalAlignment="Top" Height="30"/>
                <controls:CustomButton x:Name="ButtonExportStates" ControlBackground="{DynamicResource ButtonBackgroundFirstType}" ControlBorderBrush="{DynamicResource BorderPrimary}" ControlMouseOverBackground="{DynamicResource ButtonOverFirstType}" ControlMouseOverBorderBrush="{DynamicResource BorderSecondary}" ControlForeground="{DynamicResource TextPrimary}" ControlBorderThickness="1" ControlContent="Export" ControlFontSize="14" ControlMousePressedMargin="2" BorderThickness="1" Margin="0,61,0,0" VerticalAlignment="Top" Height="30" Grid.Column="1"/>
                <controls:CustomButton x:Name="ButtonSortStates" ControlBackground="{DynamicResource ButtonBackgroundFirstType}" ControlBorderBrush="{DynamicResource BorderPrimary}" ControlMouseOverBackground="{DynamicResource ButtonOverFirstType}" ControlMouseOverBorderBrush="{DynamicResource BorderSecondary}" ControlForeground="{DynamicResource TextPrimary}" ControlBorderThickness="1" ControlContent="Sort" ControlFontSize="14" ControlMousePressedMargin="2" BorderThickness="1" Margin="0,61,9,0" VerticalAlignment="Top" Height="30" Grid.Column="2"/>

            </Grid>
        </Border>

        <!-- Word Dictionary -->
        <Border BorderBrush="{DynamicResource BackgroundTertiary}" Grid.Column="1" Margin="0,0,0,42">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Word dictionary" FontSize="20" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="61,10,0,0" Grid.ColumnSpan="2"/>
                <TextBox x:Name="TextBoxWordDictionary" BorderBrush="{DynamicResource BackgroundTertiary}" BorderThickness="1" Margin="10,90,10,10" TextWrapping="Wrap" AcceptsReturn="True" Background="{DynamicResource BackgroundSecondary}" FontSize="16" Foreground="{DynamicResource TextSecondary}" Grid.ColumnSpan="3"/>
                <controls:CustomButton x:Name="ButtonImportWords" ControlBackground="{DynamicResource ButtonBackgroundFirstType}" ControlBorderBrush="{DynamicResource BorderPrimary}" ControlMouseOverBackground="{DynamicResource ButtonOverFirstType}" ControlMouseOverBorderBrush="{DynamicResource BorderSecondary}" ControlForeground="{DynamicResource TextPrimary}" ControlBorderThickness="1" ControlContent="Import" ControlFontSize="14" ControlMousePressedMargin="2" BorderThickness="1" Margin="9,61,0,0" VerticalAlignment="Top" Height="30"/>
                <controls:CustomButton x:Name="ButtonExportWords" ControlBackground="{DynamicResource ButtonBackgroundFirstType}" ControlBorderBrush="{DynamicResource BorderPrimary}" ControlMouseOverBackground="{DynamicResource ButtonOverFirstType}" ControlMouseOverBorderBrush="{DynamicResource BorderSecondary}" ControlForeground="{DynamicResource TextPrimary}" ControlBorderThickness="1" ControlContent="Export" ControlFontSize="14" ControlMousePressedMargin="2" BorderThickness="1" Margin="0,61,0,0" VerticalAlignment="Top" Height="30" Grid.Column="1"/>
                <controls:CustomButton x:Name="ButtonSortWords" ControlBackground="{DynamicResource ButtonBackgroundFirstType}" ControlBorderBrush="{DynamicResource BorderPrimary}" ControlMouseOverBackground="{DynamicResource ButtonOverFirstType}" ControlMouseOverBorderBrush="{DynamicResource BorderSecondary}" ControlForeground="{DynamicResource TextPrimary}" ControlBorderThickness="1" ControlContent="Sort" ControlFontSize="14" ControlMousePressedMargin="2" BorderThickness="1" Margin="0,61,9,0" VerticalAlignment="Top" Height="30" Grid.Column="2"/>
            </Grid>
        </Border>

        <controls:CustomButton x:Name="ButtonApply" ControlBackground="{DynamicResource ButtonBackgroundFirstType}" ControlBorderBrush="{DynamicResource BorderPrimary}" ControlMouseOverBackground="{DynamicResource ButtonOverFirstType}" ControlMouseOverBorderBrush="{DynamicResource Blue}" ControlForeground="{DynamicResource TextPrimary}" ControlContent="Apply" ControlFontSize="14" ControlBorderThickness="1" ControlMousePressedMargin="2" ControlFontWeight="Bold" Height="35" VerticalAlignment="Bottom" Margin="10,0,10,10" Grid.ColumnSpan="2"/>

    </Grid>

</Window>
